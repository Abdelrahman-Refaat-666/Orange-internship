#include <iostream>
#include <string.h>

using namespace std;



int main() {

    string input, output;
    getline(cin, input);
    int length = input.length();
    output = input;
    for (int i = 0; i < length; i++) {
        output[i] = input[length - i - 1];
    }
    cout << output << endl;
}